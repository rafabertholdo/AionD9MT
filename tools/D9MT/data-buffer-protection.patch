+      d9mt_data_buffer_params params = { };
+      params.address = reinterpret_cast<uintptr_t>(memory);
+      params.size = size;
+      int status = D9MT_UnixCall(D9MT_FUNC_PROTECT_DATA_BUFFER, &params);
+      if (status || !params.ret_ok)
+        Logger::warn("d9mt: could not remove executable permission from data buffer");
+    }
