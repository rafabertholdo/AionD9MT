+  // D9MT_SKIP_SHADERS: comma-separated shader names (e.g. VS_<sha1>) whose
+  // draws are dropped. Per-game workaround for passes this backend renders
+  // wrongly (Aion's water overlays spread over all terrain on Metal).
+  static bool shaderSkipped(const Rc<DxvkShader>& shader) {
+    static const std::vector<std::string> names = [] {
+      std::vector<std::string> result;
+      if (const char* list = std::getenv("D9MT_SKIP_SHADERS")) {
+        std::string value(list);
+        size_t start = 0;
+        while (start <= value.size()) {
+          size_t end = value.find(',', start);
+          if (end == std::string::npos)
+            end = value.size();
+          if (end > start)
+            result.push_back(value.substr(start, end - start));
+          start = end + 1;
+        }
+      }
+      return result;
+    }();
+    if (names.empty())
+      return false;
+    std::string name = shader->debugName();
+    for (const auto& entry : names) {
+      if (name == entry)
+        return true;
+    }
+    return false;
+  }
