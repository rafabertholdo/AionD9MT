+  // Diagnostic one-frame draw dump (D9MT_DRAW_DUMP=1). Creating "d9mt-dump" in
+  // the game directory records the next presented frame to d9mt-dump.txt.
+  std::atomic<FILE*> g_drawDump = { nullptr };
+  std::mutex         g_drawDumpMutex;
+  uint32_t           g_drawDumpIndex = 0;
+  std::vector<std::string> g_drawSkip;
+  std::atomic<bool>  g_drawSkipActive = { false };
+
+  uint32_t g_frameDrawIndex = 0;
+
+  // "+NAME" entries in d9mt-skip: draw matching (e.g. color-masked
+  // occlusion-query) geometry with all color channels written.
+  bool drawForcedVisible(const std::string& vs, const std::string& fs) {
+    if (!g_drawSkipActive.load(std::memory_order_relaxed))
+      return false;
+    std::lock_guard<std::mutex> lock(g_drawDumpMutex);
+    for (const auto& entry : g_drawSkip) {
+      if (entry[0] == '+' && (vs.find(entry.c_str() + 1) != std::string::npos
+                           || fs.find(entry.c_str() + 1) != std::string::npos))
+        return true;
+    }
+    return false;
+  }
+
+  bool drawSkipped(const std::string& vs, const std::string& fs) {
+    if (!g_drawSkipActive.load(std::memory_order_relaxed))
+      return false;
+    std::lock_guard<std::mutex> lock(g_drawDumpMutex);
+    uint32_t index = g_frameDrawIndex++;
+    for (const auto& entry : g_drawSkip) {
+      if (entry[0] == '+')
+        continue; // force-visible entries are handled by drawForcedVisible
+      if (entry[0] == '#') {
+        unsigned first = 0, last = 0;
+        int fields = std::sscanf(entry.c_str() + 1, "%u-%u", &first, &last);
+        if (fields == 1)
+          last = first;
+        if (fields >= 1 && index >= first && index <= last)
+          return true;
+        continue;
+      }
+      if (vs.find(entry) != std::string::npos || fs.find(entry) != std::string::npos)
+        return true;
+    }
+    return false;
+  }
+
+  std::atomic<FILE*> g_apiLog = { nullptr };
+
+  bool apiLogActive() {
+    return g_apiLog.load(std::memory_order_relaxed) != nullptr;
+  }
+
+  void apiLog(const char* format, ...) {
+    std::lock_guard<std::mutex> lock(g_drawDumpMutex);
+    FILE* file = g_apiLog.load();
+    if (!file)
+      return;
+    va_list args;
+    va_start(args, format);
+    std::vfprintf(file, format, args);
+    va_end(args);
+  }
+
+  void drawDumpTick() {
+    static const bool enabled = [] {
+      const char* v = std::getenv("D9MT_DRAW_DUMP");
+      return v && v[0] == '1';
+    }();
+    if (!enabled)
+      return;
+
+    std::lock_guard<std::mutex> lock(g_drawDumpMutex);
+    if (FILE* file = g_drawDump.exchange(nullptr)) {
+      std::fclose(file);
+      if (FILE* api = g_apiLog.exchange(nullptr))
+        std::fclose(api);
+      return;
+    }
+
+    struct stat st;
+    {
+      // live skip list: one VS/FS name substring per line in "d9mt-skip"
+      std::vector<std::string> skip;
+      if (FILE* file = std::fopen("d9mt-skip", "r")) {
+        char line[256];
+        while (std::fgets(line, sizeof(line), file)) {
+          std::string entry(line);
+          while (!entry.empty() && (entry.back() == '\n' || entry.back() == '\r' || entry.back() == ' '))
+            entry.pop_back();
+          if (!entry.empty())
+            skip.push_back(entry);
+        }
+        std::fclose(file);
+      }
+      g_drawSkip = std::move(skip);
+      g_drawSkipActive.store(!g_drawSkip.empty());
+      g_frameDrawIndex = 0;
+    }
+
+    if (::stat("d9mt-dump", &st) != 0)
+      return;
+    ::unlink("d9mt-dump");
+    g_drawDumpIndex = 0;
+    g_drawDump.store(std::fopen("d9mt-dump.txt", "w"));
+    g_apiLog.store(std::fopen("d9mt-api.txt", "w"));
+  }
